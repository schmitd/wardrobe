{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["scripts/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"],
      "passThroughEnv": [
        "SSL_CERT_FILE",
        "NODE_EXTRA_CA_CERTS",
        "NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy"
      ],
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_JWT_TEMPLATE",
        "GEMINI_API_KEY",
        "OPENAI_API_KEY",
        "ZEP_KEY",
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
        "NEXT_PUBLIC_POSTHOG_HOST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
