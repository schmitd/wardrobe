{
  "name": "wardrobe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@wardrobe/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "observability:smoke": "bun run apps/web/scripts/observability-smoke.ts",
    "web-build": "turbo build --filter=@wardrobe/web",
    "vercel-build": "bun run --cwd apps/web convex deploy --cmd \"cd ../.. && bun run web-build\""
  },
  "devDependencies": {
    "turbo": "^2.8.0",
    "typescript": "^5"
  }
}
