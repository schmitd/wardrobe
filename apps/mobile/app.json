{
  "expo": {
    "name": "Wardrobe",
    "slug": "wardrobe",
    "scheme": "wardrobe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wardrobe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Wardrobe uses the camera to record fit checks and add clothing you own or want to try.",
        "NSPhotoLibraryUsageDescription": "Wardrobe lets you choose fit checks and clothing photos from your library."
      }
    },
    "android": {
      "package": "com.wardrobe.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f6f1f8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wardrobe to take fit checks and clothing photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wardrobe to choose fit checks and clothing photos."
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b4470c6-c65f-493d-9cfd-c309f304e63c"
      }
    },
    "owner": "schmitd"
  }
}
