    "@tanstack/react-query": "^5.101.2",
    "@wardrobe/context-client": "workspace:*",
    "@wardrobe/shared": "workspace:*",
    "convex": "1.31.7",
    "effect": "3.19.14",
    "expo": "~56.0.16",
    "expo-auth-session": "~56.0.15",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.22",
    "expo-image-picker": "~56.0.21",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
