{
  "name": "@wardrobe/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preflight:native-auth": "bun run scripts/check-native-auth.ts",
    "preflight:testflight": "bun run scripts/check-testflight.ts",
    "preflight:testflight:eas": "bunx eas-cli@latest env:exec production 'bun run preflight:testflight'",
    "testflight:build": "bun run preflight:testflight:eas && bunx eas-cli@latest build --platform ios --profile production --auto-submit",
    "testflight:status": "bunx eas-cli@latest submit:status --platform ios",
    "test": "bun test src/*.test.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/expo": "^3.7.8",
    "@expo/vector-icons": "^15.0.2",
    "@posthog/react-native-plugin": "^2.5.2",
    "@tanstack/react-query": "^5.101.2",
    "@wardrobe/context-client": "workspace:*",
    "@wardrobe/shared": "workspace:*",
    "convex": "1.31.7",
    "effect": "3.19.14",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.10",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.67.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-volume-manager": "github:hirbod/react-native-volume-manager#db5674c1efec5d271a303a32f68d41f4cdb08fb1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  }
}
